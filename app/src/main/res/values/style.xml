<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NavBarText">
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">2sp</item>
    </style>

    <style name="AppTheme.Amoled" parent="">
        <item name="android:colorBackground">@color/darkest_Black</item>
        <!-- set colorSurface to black -->
        <item name="colorSurface">@color/darkest_Black</item>
        <item name="colorSurfaceVariant">@color/nav_bg</item>
    </style>


    <style name="Suffix">
        <item name="android:height">54dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="text10sp">
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/poppins_family</item>
    </style>

    <!-- Filter chip for the capture composers and their defaults dialog. The check icon is off on
         purpose: it adds ~24dp when a chip is ticked, so with it on the chips change width as you
         toggle them and the whole group re-wraps under you. Selection still reads from the filled
         container. -->
    <style name="CaptureFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">?android:colorBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Demo</item>
    </style>

    <style name="ShapeAppearanceOverlay.Demo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="cornerSize">20dp</item>
        <item name="background">@id/bg</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Small list-row covers (~44-48dp wide), rounded like the downloads list's. -->
    <style name="roundedImageViewSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="MySnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:background">@drawable/round_corner</item>
    </style>

    <string name="MySnackBarText" parent="Widget.MaterialComponents.Snackbar.TextView" translatable="false">
        <item name="android:textColor">@color/bg_opp</item>
    </string>

    <style name="fontTooltip" parent="Widget.Material3.Tooltip">
        <item name="android:padding">8dp</item>
        <item name="android:textAppearance">@style/Suffix</item>
        <item name="android:layout_margin">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MaterialComponents.Tooltip</item>
    </style>

    <style name="MyPopup" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:windowTitleStyle">@style/HeadingText</item>
        <item name="android:popupBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">@drawable/shape_corner_16dp</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:layoutDirection">ltr</item>
    </style>

    <!-- Material 3 alert dialogs, in the app's type and colours. Used for every AlertDialog the
         app builds (see AlertDialogBuilder / materialDialog). MyPopup stays for the plain
         Dialogs, popup menus and cast dialogs that lean on its window attributes. -->
    <style name="ThemeOverlay.Dantotsu.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="alertDialogStyle">@style/Dantotsu.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dantotsu.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Dantotsu.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dantotsu.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dantotsu.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dantotsu.Dialog.Button</item>
        <item name="android:layoutDirection">ltr</item>
    </style>

    <!-- The stock insets keep 80dp clear above and below, which on a phone is room taken from
         the content: a tall dialog then has to scroll its buttons. 24dp still reads as floating. -->
    <style name="Dantotsu.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="backgroundInsetStart">16dp</item>
        <item name="backgroundInsetEnd">16dp</item>
        <item name="backgroundInsetTop">24dp</item>
        <item name="backgroundInsetBottom">24dp</item>
    </style>

    <style name="Dantotsu.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Dantotsu.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Poppins bold runs wide, and at the stock 12dp padding / 8dp spacing / 64dp minimum three
         buttons no longer fit a phone-width row, so the bar stacks them into a column. Tighter
         spacing keeps a three-button row on one line. -->
    <style name="Dantotsu.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="HeadingText">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="BottomNavBar" parent="">
        <!-- set background color  to transparent -->
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CircularImageView" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.CircularImageView
        </item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CircularImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Matches the account card avatar's own frame (13dp corner radius) instead of a full circle,
         so a photo fills the same rounded-square tile the provider mark sits in when signed out. -->
    <style name="RoundedFrameImageView" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.RoundedFrameImageView
        </item>
    </style>

    <style name="ShapeAppearanceOverlay.App.RoundedFrameImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">13dp</item>
    </style>


    <!--
      One box of a segmented code field â€” the sync code's groups of four, the handoff sharing code's
      single characters. Deliberately carries no maxLength: a pasted code arrives in whichever box
      has focus and CodeEntry redistributes it from there, and a length filter would truncate it
      before anything could.
    -->
    <style name="CodeEntryGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">textCapCharacters|textNoSuggestions</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">18sp</item>
        <!-- Boxed rather than underlined: a box per character reads as a code to fill in. -->
        <item name="android:background">@drawable/bg_code_box</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="CodeEntrySeparator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Section heading inside the theme download picker. -->
    <style name="ThemeDownloadSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ThemeOverlay_Dantotsu_MediaRouter" parent="ThemeOverlay.AppCompat" />

    <!-- Create/edit forms (stacks, reviews, posts), inside FormSection cards. -->

    <!-- A text field on a form: outlined, with the rounder corners the cards around it use. -->
    <style name="Widget.Dantotsu.FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- The name over a group of choices (chips, a slider). -->
    <style name="Dantotsu.FormLabel" parent="">
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Small print under a field or group. -->
    <style name="Dantotsu.FormHint" parent="">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- One format on a composer's Markdown bar. -->
    <style name="Widget.Dantotsu.MarkdownButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- An on/off option, one per row. -->
    <style name="Dantotsu.FormSwitch" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>