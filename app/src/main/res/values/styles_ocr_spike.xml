<?xml version="1.0" encoding="utf-8"?><!--
  OCR detection spike. Throwaway: delete alongside ani.dantotsu.spike.
-->
<resources>

    <style name="OcrSpikeSliderLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="OcrSpikeSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!--
      A translation row in the reader's quick settings. Matches the switches it sits among, minus
      the switch: the sheet's own margins supply the horizontal inset, so unlike the settings
      screen's rows these carry no padding of their own.
    -->
    <!--
      A whole row of the reader's translation settings: its name and, beneath, what it is currently
      set to.

      The row is what is clickable, not the name inside it. Putting the ripple and the touch target
      on the name alone left the value line inert — half the row looked like part of the control and
      did not behave like it, and the visible press covered only the top half of what a press
      actually hit. The value is not a caption next to the setting, it *is* the setting's state, so
      it belongs inside the same target.
    -->
    <style name="ReaderMtlRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- The name line inside a [ReaderMtlRow]. Deliberately not clickable: the row is. -->
    <style name="ReaderMtlRowLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:elegantTextHeight">true</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="drawableTint">?attr/colorPrimary</item>
    </style>

    <style name="ReaderMtlRowState">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:alpha">0.58</item>
        <item name="android:fontFamily">@font/poppins_family</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The explanatory line under a clickable OCR & MTL row. -->
    <style name="OcrSettingSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="android:alpha">0.58</item>
        <item name="android:fontFamily">@font/poppins_family</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
