<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tags used by MaterialButton.setIconSpinning to track a button's running spin. -->
    <item name="spin_animator" type="id" />
    <item name="spin_original_icon" type="id" />

    <!--
      Stable identifiers for the media-details bottom nav tabs, passed to navBar.createTab.

      These were previously declared by anime_menu_detail, manga_menu_detail and
      novel_menu_detail — three menus nothing ever inflated, kept alive only because deleting
      them would have taken these ids with them. Declaring the ids where they belong lets the
      menus go.
    -->
    <item name="info" type="id" />
    <item name="watch" type="id" />
    <item name="read" type="id" />
    <item name="comment" type="id" />

    <!--
      View tags for the reader's zoom-aware re-render: the zoom a page was last decoded for, and
      the gesture listener watching for that to change. Both live on the page's item view so
      recycling clears them with it. See BaseImageAdapter.
    -->
    <item name="page_render_zoom" type="id" />
    <item name="page_zoom_listener" type="id" />
</resources>
