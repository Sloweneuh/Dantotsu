<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tags used by MaterialButton.setIconSpinning to track a button's running spin. -->
    <item name="spin_animator" type="id" />
    <item name="spin_original_icon" type="id" />

    <!--
      Stable identifiers for the media-details bottom nav tabs, passed to navBar.createTab.

      These were previously declared by anime_menu_detail, manga_menu_detail and
      novel_menu_detail — three menus nothing ever inflated, kept alive only because deleting
      them would have taken these ids with them. Declaring the ids where they belong lets the
      menus go.
    -->
    <item name="info" type="id" />
    <item name="watch" type="id" />
    <item name="read" type="id" />
    <item name="comment" type="id" />

    <!--
      View tags for the reader's zoom-aware re-render: the zoom a page was last decoded for, and
      the gesture listener watching for that to change. Both live on the page's item view so
      recycling clears them with it. See BaseImageAdapter.
    -->
    <item name="page_render_zoom" type="id" />
    <item name="page_zoom_listener" type="id" />

    <!-- Set on a ViewPager2 while ViewPager2.jumpTo moves it, so the shared-axis motion skips it. -->
    <item name="pager_quiet_jump" type="id" />

    <!-- Set on a ViewPager2 by useSharedAxisTransitions, and the page a switchTo is fading out towards. -->
    <item name="shared_axis_pager" type="id" />
    <item name="pager_switch_target" type="id" />

    <!-- Set on a source TextInputLayout once followSourceIcon has hooked its text. -->
    <item name="source_icon_follow" type="id" />

    <!-- Whether a notification swipe's icon is showing "far enough to go through"; see NotificationSwipeCallback. -->
    <item name="swipe_armed" type="id" />

    <!-- A settings card's running colour and height animations; see SectionCard. -->
    <item name="section_card_anim" type="id" />
    <!-- A settings row's top margin as inflated; SettingsAdapter restores it on rows it hid. -->
    <item name="settings_row_top_margin" type="id" />
    <!-- initActivity: this screen already pads its content in from the side insets. -->
    <item name="side_insets_applied" type="id" />
    <item name="section_height_anim" type="id" />
    <item name="section_collapsing" type="id" />
    <item name="quick_tile_relight" type="id" />
    <item name="quick_tile_resize" type="id" />
</resources>
