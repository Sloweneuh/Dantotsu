<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml, for both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ani.dantotsu.protected.xml" />
        <exclude domain="sharedpref" path="ani.dantotsu.protected_encrypted.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ani.dantotsu.protected.xml" />
        <exclude domain="sharedpref" path="ani.dantotsu.protected_encrypted.xml" />
    </device-transfer>
</data-extraction-rules>
