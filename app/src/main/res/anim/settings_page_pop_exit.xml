<?xml version="1.0" encoding="utf-8"?><!-- Shared-axis X, back: the page being closed drifts off to the right as it fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <translate
        android:duration="300"
        android:fromXDelta="0"
        android:toXDelta="8%" />
    <alpha
        android:duration="90"
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
