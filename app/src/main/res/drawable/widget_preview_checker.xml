<?xml version="1.0" encoding="utf-8"?><!--
    The surface behind the configure screen's preview. Deliberately a neutral mid grey rather than the
    screen background: a translucent widget colour has to be seen against something that is neither the
    widget's own colour nor the page's, or it reads as opaque.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33808080" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
