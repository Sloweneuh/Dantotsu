<!--
  MangaBaka's "unweighted" indicator: a chevron drawn with a dashed round-capped stroke
  (their SVG uses stroke-dasharray="1.6 1.6", stroke-linecap="round"). VectorDrawable has no
  dash-array, so the chevron is split into round-capped dashes. Gaps are sized ~2x the dashes
  (rather than a literal 1:1 dasharray) so the dashing still reads clearly at small on-screen
  icon sizes on mobile. The pattern is centred on the peak so the mark stays symmetric.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,13 L7.71,11.86" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M11.14,9.57 L12,9 L12.86,9.57" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16.29,11.86 L18,13" />
</vector>
