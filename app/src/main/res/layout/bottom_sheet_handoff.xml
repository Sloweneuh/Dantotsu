<?xml version="1.0" encoding="utf-8"?>
<!-- Continue on another device: what's being handed off, the nearby devices on one card (the
     search, discovery and the list, which is what the sheet is for), then the other ways to hand
     off — a QR code or a code to type — as tonal buttons below. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:alpha="0.4"
            android:background="@drawable/bg_top_banner_handle" />

        <TextView
            android:id="@+id/handoffTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_bold"
            android:paddingHorizontal="4dp"
            android:text="@string/continue_on_another_device"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/handoffSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="@string/handoff_media_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffEnableBluetooth"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_enable_bluetooth"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_bluetooth_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffEnableWifi"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_enable_wifi"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_wifi_24"
            app:iconGravity="textStart" />

        <!-- Untitled: the status line says what the card is doing (searching, none found). -->
        <ani.dantotsu.others.FormSection
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ani.dantotsu.others.MaterialProgressBar
                    android:id="@+id/handoffProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/handoffStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="@string/handoff_searching" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/handoffDeviceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- A switch rather than the old one-way "enable discovery" button: this is the screen
                 discovery exists for, so it is also where turning it back off belongs. -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/handoffDiscoveryToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_round_cast_24"
                android:drawablePadding="16dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:minHeight="52dp"
                android:text="@string/handoff_discovery_setting"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                app:drawableTint="?attr/colorPrimary"
                app:showText="false"
                app:thumbTint="@color/button_switch_track" />
        </ani.dantotsu.others.FormSection>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_show_qr"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_qr_code_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffShareCode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_share_code"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_share_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffReceiveQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_receive_via_qr"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_qr_code_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/handoffReceiveCode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            android:text="@string/handoff_receive_via_code"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_round_share_24"
            app:iconGravity="textStart" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
