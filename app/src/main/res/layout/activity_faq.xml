<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/faqLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".settings.FAQActivity">

    <!-- The header every settings page has, so About's FAQ row can fly its icon into it. -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <ImageButton
            android:id="@+id/faqBack"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/nav_bg_inv"
            android:contentDescription="@string/back"
            android:padding="16dp"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="?attr/colorOnBackground" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        tools:ignore="UseCompoundDrawables">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="32dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/faq"
            android:textSize="28sp" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:transitionName="settingsPageIcon"
            app:srcCompat="@drawable/ic_round_quiz_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <ani.dantotsu.FadingEdgeRecyclerView
        android:id="@+id/devsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="64dp"
        android:requiresFadingEdge="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="10"
        tools:listitem="@layout/item_question"
        tools:orientation="vertical" />
</LinearLayout>
