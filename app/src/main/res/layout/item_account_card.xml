<?xml version="1.0" encoding="utf-8"?>
<!-- One provider on the Accounts screen. Collapsed it shows the mark, name, avatar and a
     login/logout control; expanded it reveals that provider's toggles and shortcuts in
     [accountBody] (a nested SettingsAdapter list). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accountCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/accountCardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp">

            <FrameLayout
                android:id="@+id/accountAvatarFrame"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp">

                    <!-- User photo: fills the tile, masked to the same rounded-square frame as the
                         provider mark below (not a circle). Hidden while a provider mark shows. -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/accountAvatar"
                        style="@style/RoundedFrameImageView"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:ignore="ContentDescription,ImageContrastCheck" />

                    <!-- Provider mark: contained + padded, NO circular mask (that clips square
                         logos like MangaUpdates' / Simkl's). -->
                    <ImageView
                        android:id="@+id/accountLogo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_round_person_24"
                        app:tint="?attr/colorPrimary"
                        tools:ignore="ContentDescription,ImageContrastCheck" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Small provider badge over the avatar: a rounded-square plate with padding so a
                     round OR square mark sits inside without cropping. Discord swaps it for a dot. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/accountBadgeCard"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|end"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="7dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/accountBadge"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:padding="3dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        tools:ignore="ContentDescription"
                        tools:src="@drawable/ic_anilist" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    tools:text="Slowen" />

                <TextView
                    android:id="@+id/accountSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.66"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="MyAnimeList · connected" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/accountInfo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_round_help_24"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:ignore="ContentDescription" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/accountLogin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/login"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_round_login_24"
                app:iconGravity="textStart"
                app:iconPadding="5dp"
                app:iconSize="15dp" />

            <ImageButton
                android:id="@+id/accountLogout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_round_logout_24"
                app:tint="?attr/colorError"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/accountChevron"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                app:srcCompat="@drawable/ic_round_arrow_drop_down_24"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <View
            android:id="@+id/accountBodyDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="14dp"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/accountBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:listitem="@layout/item_settings_switch" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
