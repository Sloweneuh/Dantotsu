<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsible header over a section of the Comick matches: matched by hand, or marked
     "not on Comick". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/ripple_rounded_8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/comickMatchHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            tools:text="Marked not on Comick (3)" />

        <TextView
            android:id="@+id/comickMatchHeaderDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            tools:text="@string/comick_unmatched_hidden_desc"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/comickMatchHeaderChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_round_arrow_drop_down_24"
        app:tint="?attr/colorOnBackground" />
</LinearLayout>
