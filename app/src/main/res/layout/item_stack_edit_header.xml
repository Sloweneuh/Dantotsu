<?xml version="1.0" encoding="utf-8"?>
<!-- The stack form above its series list, in carded groups like the settings screens: what the
     stack is, who it's for and who can see it, and its options. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp">

    <ani.dantotsu.others.FormSection
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_round_edit_note_24"
        app:summary="@string/stack_section_details_desc"
        app:title="@string/form_section_details">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/stackEditNameLayout"
            style="@style/Widget.Dantotsu.FormField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/stack_field_title"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/stackEditName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="200"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Dantotsu.FormField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/stack_field_description"
            app:helperText="@string/stack_markdown_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/stackEditDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="10000"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
    </ani.dantotsu.others.FormSection>

    <ani.dantotsu.others.FormSection
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:icon="@drawable/ic_round_public_24"
        app:summary="@string/stack_section_audience_desc"
        app:title="@string/stack_section_audience">

        <TextView
            style="@style/Dantotsu.FormLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/content_rating" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/stackEditRatingChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/Dantotsu.FormLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stack_field_visibility" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/stackEditVisibilityChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/Dantotsu.FormHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stack_publish_hint" />
    </ani.dantotsu.others.FormSection>

    <ani.dantotsu.others.FormSection
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:icon="@drawable/ic_round_tune_24"
        app:title="@string/form_section_options">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/stackEditSpoiler"
            style="@style/Dantotsu.FormSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stack_field_spoiler" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/stackEditComments"
            style="@style/Dantotsu.FormSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/stack_field_comments" />
    </ani.dantotsu.others.FormSection>

    <!-- The series list's own header: the rows below it are the list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stackEditEntriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="Series (3)" />

            <TextView
                style="@style/Dantotsu.FormHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/stack_entries_hint" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stackEditAddSeries"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/stack_add_series"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

</LinearLayout>
