<?xml version="1.0" encoding="utf-8"?><!--
    Widget picker preview for the Continue widget. Its own layout rather than widget_continue, which
    is empty until ContinueWidget fills it in — see widget_preview_upcoming.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="74dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/preview_cover_frieren" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/widget_continue"
            android:textColor="#FFD0BCFF"
            android:textSize="12sp" />

        <TextView
            style="@style/WidgetPreviewTitle"
            android:maxLines="2"
            android:text="@string/widget_preview_title" />

        <TextView
            style="@style/WidgetPreviewSubtitle"
            android:text="@string/widget_preview_subtitle_continue" />
    </LinearLayout>
</LinearLayout>
