<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingEnd="8dp"
        tools:ignore="RtlSymmetry">

        <!-- Drags at a touch, with a wide target; holding anywhere else on the card works too. -->
        <ImageView
            android:id="@+id/infoSectionHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_drag_indicator_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/infoSectionContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                tools:text="Recommended" />

            <LinearLayout
                android:id="@+id/infoSectionMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/infoSectionIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/infoSectionMerged"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_settings_section_icon"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="1dp"
                    android:text="@string/info_tab_merged"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/infoSectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="3 hidden" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/infoSectionAbout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_tab_section_about"
            android:padding="9dp"
            app:srcCompat="@drawable/ic_round_help_outline_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/infoSectionFields"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_tab_visible_details"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_round_tune_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/infoSectionRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_tab_remove_section"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_round_close_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/infoSectionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/info_tab_builtin_hint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
