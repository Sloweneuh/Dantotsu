<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:alpha="0.4"
            android:background="@drawable/bg_top_banner_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/novel_tts"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <!--
            Caption above the control, not beside it: a Spinner sized to its widest entry claims the
            whole row, and LinearLayout settles the overflow by shrinking the weighted caption away.
            The reader's own settings sheet learned this the hard way.
        -->
        <ani.dantotsu.others.FormSection
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_round_volume_up_24"
            app:title="@string/novel_tts_voice">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/novel_tts_engine" />

                <ani.dantotsu.SpinnerNoSwipe
                    android:id="@+id/ttsEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:popupBackground="@drawable/round_corner"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/novel_tts_voice" />

                <ani.dantotsu.SpinnerNoSwipe
                    android:id="@+id/ttsVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:popupBackground="@drawable/round_corner"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ttsSpeedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/speed"
                    tools:text="Speed — 1.0x" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ttsSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.25"
                    android:valueTo="3.0"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ttsPitchLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/novel_tts_pitch"
                    tools:text="Pitch — 1.0" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ttsPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </ani.dantotsu.others.FormSection>

        <ani.dantotsu.others.FormSection
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:icon="@drawable/ic_round_tune_24"
            app:title="@string/form_section_options">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ttsAutoNextChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:drawableStart="@drawable/ic_round_skip_next_24"
                android:drawablePadding="16dp"
                android:elegantTextHeight="true"
                android:fontFamily="@font/poppins_bold"
                android:minHeight="52dp"
                android:text="@string/novel_tts_auto_next_chapter"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                app:cornerRadius="0dp"
                app:drawableTint="?attr/colorPrimary"
                app:showText="false"
                app:thumbTint="@color/button_switch_track"
                tools:ignore="VisualLintButtonSize" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ttsFollowText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:drawableStart="@drawable/ic_round_menu_book_24"
                android:drawablePadding="16dp"
                android:elegantTextHeight="true"
                android:fontFamily="@font/poppins_bold"
                android:minHeight="52dp"
                android:text="@string/novel_tts_follow_text"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                app:cornerRadius="0dp"
                app:drawableTint="?attr/colorPrimary"
                app:showText="false"
                app:thumbTint="@color/button_switch_track"
                tools:ignore="VisualLintButtonSize" />

            <LinearLayout
                android:id="@+id/ttsSleepTimerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/novel_tts_sleep_timer" />

                <ani.dantotsu.SpinnerNoSwipe
                    android:id="@+id/ttsSleepTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:popupBackground="@drawable/round_corner"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>
        </ani.dantotsu.others.FormSection>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="4dp"
            android:text="@string/novel_tts_engine_desc"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
