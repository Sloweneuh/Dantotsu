<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?android:colorBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/customInfoScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ani.dantotsu.others.MaterialProgressBar
                android:id="@+id/customInfoProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="32dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/customInfoEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.58"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/info_tab_nothing_to_show"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/customInfoContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/info_section_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <!-- The source fragments run here, out of sight; their sections move to the content above. -->
            <FrameLayout
                android:id="@+id/customInfoSources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.cardview.widget.CardView>
