<?xml version="1.0" encoding="utf-8"?><!--
    What the widget picker shows for the upcoming widget (previewLayout, Android 12+).

    A separate layout from widget_media_list on purpose: the picker inflates it without running any of
    our code, so a live widget layout previews as an empty card — its title is bound at runtime and its
    ListView has no adapter to fill. Everything here is literal, covers included.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dantotsu_round" />

        <TextView
            style="@style/WidgetPreviewHeader"
            android:text="@string/upcoming" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPreviewRow">

        <ImageView
            style="@style/WidgetPreviewCover"
            android:contentDescription="@null"
            android:src="@drawable/preview_cover_frieren" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetPreviewTitle"
                android:text="@string/widget_preview_title" />

            <TextView
                style="@style/WidgetPreviewSubtitle"
                android:text="@string/widget_preview_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/WidgetPreviewRow">

        <ImageView
            style="@style/WidgetPreviewCover"
            android:contentDescription="@null"
            android:src="@drawable/preview_cover_vinland" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetPreviewTitle"
                android:text="@string/widget_preview_title_two" />

            <TextView
                style="@style/WidgetPreviewSubtitle"
                android:text="@string/widget_preview_subtitle_two" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
