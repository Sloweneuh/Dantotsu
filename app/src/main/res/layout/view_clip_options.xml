<?xml version="1.0" encoding="utf-8"?><!--
    Everything that isn't the preview. Filter chips rather than a column of switches: eight toggles
    as full-width rows ran to several hundred dp, which is what pushed the preview off screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/clipFormatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/clipFormatVideo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/clip_format_video" />

        <Button
            android:id="@+id/clipFormatGif"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/clip_format_gif" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- GIF encoding settings, shown only while GIF is the chosen format. These are the two knobs
         that visibly change the result, so they belong next to the preview that shows it rather
         than buried in the defaults dialog. Changes are written back as the new defaults. -->
    <LinearLayout
        android:id="@+id/clipGifSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/clipGifFpsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp"
            tools:text="GIF frame rate: 15 fps" />

        <com.google.android.material.slider.Slider
            android:id="@+id/clipGifFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="5"
            android:valueTo="30" />

        <TextView
            android:id="@+id/clipGifWidthLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp"
            tools:text="GIF width: 480 px" />

        <com.google.android.material.slider.Slider
            android:id="@+id/clipGifWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="80"
            android:valueFrom="240"
            android:valueTo="720" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/clipCaptionLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/clipCaptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:hint="@string/screenshot_caption_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="120"
            android:maxLines="2" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/clipTitleSelectLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/screenshot_title_label"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        tools:visibility="visible">

        <AutoCompleteTextView
            android:id="@+id/clipTitleSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:inputType="none"
            tools:ignore="LabelFor"
            tools:text="One Piece" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/clipChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingVertical="0dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSubtitles"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/clip_burn_subtitles" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMediaInfo"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_media_info" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDate"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_date" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSource"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_source" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUserInfo"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screenshot_show_user_info" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAppIcon"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_app_icon" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFrame"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_frame" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRounded"
            style="@style/CaptureFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/screenshot_show_rounded_corners" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
