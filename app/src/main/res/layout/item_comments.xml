<?xml version="1.0" encoding="utf-8"?>
<!-- One comment: avatar beside a header (name, level, age, badges, the chapter it's about), the
     text, and one row of actions under it — votes, reply, edit, more — then its replies, indented
     behind a thread line. Every id CommentItem binds is kept. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentsCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/commentUserAvatarContainer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/commentUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_round_person_24"
            tools:ignore="ContentDescription,ImageContrastCheck" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name, level, age, badges and chapter on one line; the name gives way first. -->
    <LinearLayout
        android:id="@+id/commentUserDetailsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/commentUserAvatarContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/commentUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:singleLine="true"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            tools:text="Username" />

        <TextView
            android:id="@+id/commentUserLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="11sp"
            tools:ignore="SmallSp"
            tools:text="[7]" />

        <ImageView
            android:id="@+id/adminBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_crown"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/modBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_shield"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/commentUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.55"
            android:fontFamily="@font/poppins_family"
            android:singleLine="true"
            android:textSize="11sp"
            tools:ignore="SmallSp"
            tools:text="· 1y" />

        <!-- The chapter or episode the comment is about, when it was tagged with one. -->
        <LinearLayout
            android:id="@+id/commentUserTagLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/toolbox_pill_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_label_24"
                app:tint="?attr/colorOnSecondaryContainer"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/commentUserTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="11sp"
                tools:ignore="SmallSp"
                tools:text="36" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/commentText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_family"
        android:lineSpacingExtra="1dp"
        android:maxLines="8"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/commentUserDetailsLayout"
        tools:text="@string/slogan" />

    <!-- Votes in one pill, Reply and Edit as pills of their own, the menu at the end: each a
         finger-sized target rather than a bare word or a 24dp arrow. -->
    <LinearLayout
        android:id="@+id/commentActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentText"
        app:layout_constraintTop_toBottomOf="@id/commentText">

        <LinearLayout
            android:id="@+id/commentVotes"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/comment_action_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/commentUpVote"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/upvote"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                app:srcCompat="@drawable/ic_round_upvote_inactive_24" />

            <TextView
                android:id="@+id/commentTotalVotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:minWidth="14dp"
                android:textSize="12sp"
                tools:text="12" />

            <ImageView
                android:id="@+id/commentDownVote"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/downvote"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:rotation="180"
                app:srcCompat="@drawable/ic_round_upvote_inactive_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/commentReply"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/comment_action_background"
            android:drawablePadding="6dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/reply"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_round_reply_24"
            app:drawableTint="?attr/colorOnBackground" />

        <TextView
            android:id="@+id/commentEdit"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/comment_action_background"
            android:drawablePadding="6dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/edit"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_round_edit_24"
            app:drawableTint="?attr/colorOnBackground" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/commentInfo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:alpha="0.7"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_round_dots_vertical_24" />
    </LinearLayout>

    <!-- "View 3 replies", under the actions rather than squeezed into them. -->
    <LinearLayout
        android:id="@+id/commentRepliesToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@id/commentText"
        app:layout_constraintTop_toBottomOf="@id/commentActions">

        <View
            android:id="@+id/commentRepliesDivider"
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:alpha="0.5"
            android:background="?attr/colorOnBackground" />

        <TextView
            android:id="@+id/commentTotalReplies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins_bold"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            tools:text="View 3 replies" />
    </LinearLayout>

    <!-- Replies, indented under the avatar behind a thread line. -->
    <View
        android:id="@+id/commentThreadLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:alpha="0.15"
        android:background="?attr/colorOnBackground"
        app:layout_constraintBottom_toBottomOf="@id/commentRepliesList"
        app:layout_constraintEnd_toEndOf="@id/commentUserAvatarContainer"
        app:layout_constraintStart_toStartOf="@id/commentUserAvatarContainer"
        app:layout_constraintTop_toTopOf="@id/commentRepliesList" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentRepliesList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/commentRepliesToggle"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
