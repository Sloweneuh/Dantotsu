<?xml version="1.0" encoding="utf-8"?>
<!-- Design lab: the main screen's AnimatedBottomBar (copied from item_navbar) against the
     Material 3 Expressive bottom navigation and the 1.14 floating toolbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AnimatedBottomBar (current)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <nl.joery.animatedbottombar.AnimatedBottomBar
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_nav"
        android:elevation="8dp"
        android:padding="6dp"
        app:abb_animationDuration="300"
        app:abb_animationInterpolator="@anim/over_shoot"
        app:abb_indicatorColor="?attr/colorTertiary"
        app:abb_indicatorLocation="bottom"
        app:abb_indicatorMargin="28dp"
        app:abb_selectedIndex="1"
        app:abb_selectedTabType="text"
        app:abb_tabColor="?attr/colorOutline"
        app:abb_tabColorDisabled="?attr/colorPrimaryContainer"
        app:abb_tabColorSelected="?attr/colorPrimary"
        app:abb_tabs="@menu/bottom_navbar_menu"
        app:abb_textAppearance="@style/NavBarText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BottomNavigationView (M3 Expressive)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/designLabBottomNav"
        style="@style/Widget.Material3Expressive.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:menu="@menu/bottom_navbar_menu" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media page AnimatedBottomBar (current, copied from activity_media)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- Tabs are added in code, as MediaDetailsActivity does. -->
    <nl.joery.animatedbottombar.AnimatedBottomBar
        android:id="@+id/designLabMediaBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:padding="0dp"
        app:abb_animationInterpolator="@anim/over_shoot"
        app:abb_indicatorAppearance="round"
        app:abb_indicatorLocation="top"
        app:abb_selectedTabType="text"
        app:abb_textAppearance="@style/NavBarText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media page as BottomNavigationView (M3 Expressive)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- Menu filled in code with the media page's three tabs. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/designLabMediaNav"
        style="@style/Widget.Material3Expressive.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media page as BottomNavigationView, label on the selected tab only"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- Same tabs as designLabMediaNav; only the label visibility differs. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/designLabMediaNavSelected"
        style="@style/Widget.Material3Expressive.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:labelVisibilityMode="selected" />

    <!-- The floating toolbar holds actions for the current screen, not navigation: only a
         genuine on/off action (favourite, grid view) is checkable, and those toggle on their own. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Floating toolbar (1.14): actions on selected list items, e.g. a long-press selection"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Favourite"
                android:checkable="true"
                app:icon="@drawable/ic_round_favorite_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Share"
                app:icon="@drawable/ic_round_share_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Download"
                app:icon="@drawable/ic_round_download_manager_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Delete"
                app:icon="@drawable/ic_round_delete_24" />
        </LinearLayout>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vibrant variant: library tools (search, filter, sort, grid toggle)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        style="@style/Widget.Material3.FloatingToolbar.Vibrant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton.Vibrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Search"
                app:icon="@drawable/ic_round_search_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton.Vibrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Filter"
                app:icon="@drawable/ic_round_filter_alt_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton.Vibrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Sort"
                app:icon="@drawable/ic_round_sort_24" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.FloatingToolbar.IconButton.Vibrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Grid view"
                android:checkable="true"
                app:icon="@drawable/ic_round_grid_view_24" />
        </LinearLayout>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
</LinearLayout>
