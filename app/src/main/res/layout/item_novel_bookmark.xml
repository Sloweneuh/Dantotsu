<?xml version="1.0" encoding="utf-8"?>
<!-- A bookmark (NovelBookmarksSheet): its chapter, the start of its page and when it was made. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/novelBookmarkChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="Chapter 12 · The Floating Island" />

        <TextView
            android:id="@+id/novelBookmarkExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="Clearly, she was hiding something, but Amane had no intention to probe further" />

        <TextView
            android:id="@+id/novelBookmarkDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="22 Oct 2026" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/novelBookmarkDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/novel_bookmark_delete"
        android:src="@drawable/ic_round_delete_24"
        android:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
