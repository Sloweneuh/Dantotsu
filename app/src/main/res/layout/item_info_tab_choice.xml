<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingEnd="12dp"
        tools:ignore="RtlSymmetry">

        <ImageView
            android:id="@+id/infoTabHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_drag_indicator_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <FrameLayout
            android:id="@+id/infoTabIconTile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_section_icon">

            <ImageView
                android:id="@+id/infoTabIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/infoTabText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="AniList" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/infoTabSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
