<?xml version="1.0" encoding="utf-8"?>
<!--
  A titled row of chips. The chips stay on one line and scroll sideways; when they don't all fit,
  ChipSections shows the chevron, which lays them out over as many lines as they need.
-->
<ani.dantotsu.others.ChipSectionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/synonyms"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/itemTitleAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_section_action" />

        <ImageView
            android:id="@+id/itemTitleExpand"
            android:tag="chipExpand"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/expand"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_section_action"
            android:src="@drawable/ic_round_arrow_drop_down_24"
            android:visibility="gone" />

    </LinearLayout>

    <ani.dantotsu.others.ChipScrollView
        android:id="@+id/itemChipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:scrollbars="none">

        <ani.dantotsu.others.ChipFlowGroup
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/itemChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:singleLine="true" />
    </ani.dantotsu.others.ChipScrollView>

</ani.dantotsu.others.ChipSectionLayout>
