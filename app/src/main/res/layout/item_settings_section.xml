<?xml version="1.0" encoding="utf-8"?>
<!-- One collapsible group on a settings screen. Collapsed it shows an icon, the group name and a
     summary of the group's current state; expanded it drops down that group's own rows in
     [sectionBody] (a nested SettingsAdapter list).

     Deliberately generic: the notification sources are the first user, but the same card is what
     lets a large section carry internal structure without spending another screen on it. The
     header is shared with the Player and Reader screens' Xpandable groups, and SectionCard gives
     both the same fill, colours and motion. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/sectionHeader"
            layout="@layout/item_settings_section_header" />

        <!-- Divider and rows together, so expanding and collapsing animate them as one. -->
        <LinearLayout
            android:id="@+id/sectionBodyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/sectionBodyDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="18dp"
                android:alpha="0.5"
                android:background="?attr/colorOutlineVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sectionBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
