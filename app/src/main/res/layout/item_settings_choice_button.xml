<?xml version="1.0" encoding="utf-8"?>
<!-- One segment of a type = 5 row's [settingsChoices] group: the same ChoiceToggleButton the reader's
     choice rows and the Appearance theme picker use, so every option row in settings looks alike. -->
<ani.dantotsu.others.ChoiceToggleButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/choiceButton"
    style="@style/Widget.Material3Expressive.Button.TonalButton"
    android:layout_width="52dp"
    android:layout_height="48dp"
    android:alpha="0.33"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:padding="0dp"
    app:iconGravity="textStart"
    app:iconPadding="0dp"
    tools:icon="@drawable/ic_round_home_24" />
