<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:backgroundTintMode="src_atop"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:paddingBottom="8dp"
        android:text="@string/customize_info_tabs"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textSize="16sp" />

    <!--
        Scrollable rather than fixed: five contexts do not fit as equal-width tabs on a phone, and
        fixed mode shrinks the labels until they are unreadable instead of letting them scroll.
    -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/infoTabContextTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:tabGravity="start"
        app:tabMode="scrollable" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/infoTabRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/infoTabButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/infoTabCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/cancel"
            android:textColor="?attr/colorPrimary" />

        <Button
            android:id="@+id/infoTabOk"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/ok"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</LinearLayout>
