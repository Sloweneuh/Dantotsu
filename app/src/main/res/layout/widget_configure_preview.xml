<?xml version="1.0" encoding="utf-8"?><!--
    A sample of the widget shown above the options in WidgetConfigureActivity. Mirrors
    widget_media_list.xml / statistics_widget.xml closely enough to judge colours, and is painted by the
    very same WidgetStyle.applyTo() call the real widgets use.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        tools:ignore="ContentDescription" />

    <!--
        wrap_content, not match_parent: the stats layout (title + two rows of value-over-label) needs
        more than the 180dp the FLAT/calendar previews are comfortable at, and a fixed height here just
        clipped its bottom row's labels off silently instead of growing to fit them.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:textSize="16sp"
            tools:text="@string/upcoming" />

        <LinearLayout
            android:id="@+id/previewRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/previewRowOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <!-- Only shown for the activity widget — see WidgetConfigureActivity.renderPreview(). -->
                <ImageView
                    android:id="@+id/previewAvatarOne"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:adjustViewBounds="true"
                    android:maxWidth="48dp"
                    android:maxHeight="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_avatar"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/previewCoverOne"
                    android:layout_width="38dp"
                    android:layout_height="52dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_cover_frieren"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/previewTitleOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:text="@string/widget_preview_title"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/previewSubtitleOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:text="@string/widget_preview_subtitle"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <!-- Only shown for the activity widget — see WidgetConfigureActivity.renderPreview(). -->
                <ImageView
                    android:id="@+id/previewAvatarTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:adjustViewBounds="true"
                    android:maxWidth="48dp"
                    android:maxHeight="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_avatar"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/previewCoverTwo"
                    android:layout_width="38dp"
                    android:layout_height="52dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_cover_vinland"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/previewTitleTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:text="@string/widget_preview_title_two"
                        android:textSize="14sp" />

                    <!--
                        Only shown for the waiting widget, where an anime row ends its subtitle in a
                        bare "·" and follows it with the dub/sub icon + code instead of text — see
                        MediaListFactory.mediaRow(). widget_preview_subtitle_two already ends that way.
                    -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/previewSubtitleTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins"
                            android:maxLines="1"
                            android:text="@string/widget_preview_subtitle_two"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/previewLanguageIcon"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_anime_sub_24" />

                        <TextView
                            android:id="@+id/previewLanguageCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="@font/poppins"
                            android:text="EN"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!--
            The schedule widget's rows, shown instead of previewRows above — it never has covers and
            groups rows under a day heading, same as MediaListFactory.calendarRow()/groupByDay().
        -->
        <LinearLayout
            android:id="@+id/previewCalendarRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/previewCalendarDayOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="4dp"
                android:text="@string/widget_today"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:id="@+id/previewCalendarTimeOne"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/widget_preview_time_one"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/previewCalendarTitleOne"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="1"
                    android:text="@string/widget_preview_title"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:id="@+id/previewCalendarTimeTwo"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/widget_preview_time_two"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/previewCalendarTitleTwo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="1"
                    android:text="@string/widget_preview_title_two"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewCalendarDayTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="4dp"
                android:text="@string/widget_tomorrow"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:id="@+id/previewCalendarTimeThree"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/widget_preview_time_four"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/previewCalendarTitleThree"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="1"
                    android:text="@string/widget_preview_title_four"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

            <!--
                The stats grid, which doubles as the picker: each cell is clickable and opens the stat
                chooser for that position, so the setting is made where its result is visible rather than
                in a separate column of dropdowns that named grid positions in words. Rows appear only as
                far as the widget's current size will actually draw them — see
                WidgetConfigureActivity.setUpStatsOptions().
            -->
            <LinearLayout
                android:id="@+id/previewStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <LinearLayout
                android:id="@+id/previewStatRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/previewStatCell1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewStatCell2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/previewStatRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/previewStatCell3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewStatCell4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/previewStatRow3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/previewStatCell5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewStatCell6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/previewStatRow4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/previewStatCell7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewStatCell8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/previewStatValue8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textSize="22sp"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/previewStatLabel8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="@string/anime_count" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
    </LinearLayout>
</FrameLayout>
