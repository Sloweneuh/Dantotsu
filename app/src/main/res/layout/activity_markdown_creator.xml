<?xml version="1.0" encoding="utf-8"?>
<!-- Writing a post, a reply or a message: the bar, a Write/Preview switch (and Private, for a new
     message), the text on a card that fills the screen, and the Markdown bar under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <include
        android:id="@+id/markdownCreatorToolbar"
        layout="@layout/layout_form_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/markdownModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/markdownModeWrite"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markdownModeWrite"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/composer_write"
                app:icon="@drawable/ic_round_edit_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markdownModePreview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/preview"
                app:icon="@drawable/ic_round_remove_red_eye_24" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/privateCheckbox"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="@string/private_mode"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_round_lock_24"
            app:chipIconVisible="true"
            tools:visibility="visible" />
    </LinearLayout>

    <ani.dantotsu.others.FormSection
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/editText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:hint="@string/reply_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true"
                    android:textSize="16sp"
                    tools:ignore="Autofill,LabelFor" />

                <TextView
                    android:id="@+id/markdownPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:padding="14dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>
        </ScrollView>
    </ani.dantotsu.others.FormSection>

    <include
        android:id="@+id/markdownOptionsContainer"
        layout="@layout/layout_markdown_toolbar" />

</LinearLayout>
