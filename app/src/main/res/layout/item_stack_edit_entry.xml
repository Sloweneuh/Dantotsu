<?xml version="1.0" encoding="utf-8"?>
<!-- One series of a stack being edited, as a small card (filled by the adapter, the way the form's
     sections are); also the result rows of the add-series search, where it stays flat. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/stackEntryHandle"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:alpha="0.7"
            android:contentDescription="@string/stack_reorder"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_round_drag_indicator_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/stackEntryRank"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            tools:text="12" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/stackEntryCover"
            android:layout_width="44dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundedImageViewSmall"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stackEntryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semi_bold"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Series title" />

            <TextView
                android:id="@+id/stackEntryNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="Why it's here" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stackEntryRemove"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/stack_remove_series"
            app:icon="@drawable/ic_round_delete_24"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
