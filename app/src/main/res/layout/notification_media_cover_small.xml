<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- wrap_content, not a fixed height: DecoratedCustomViewStyle already spends part of the
         collapsed row's height budget on its own header (small icon, app name, timestamp), so a
         tall fixed-height row here pushes the total past what some versions allow and gets
         clipped. A compact, content-sized row leaves that room alone. The cover's own height is
         the actual limiting factor — even alone (no text overflow), 53dp was still taller than
         the real budget and was getting clipped top/bottom; 44dp (close to the classic 48dp
         collapsed-notification icon size) leaves real headroom under it. -->
    <ImageView
        android:id="@+id/notificationCover"
        android:layout_width="30dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!-- Hidden (gone) unless a generic label ("New Chapter Available", ...) is set. The
             collapsed custom content view gets no header decoration of its own (no app name, no
             subText — that only shows for the expanded/big view), so this is the only place that
             label can go. All three lines below use includeFontPadding="false" and no inter-line
             margin: wrap_content's default font padding reserves more vertical space than the
             glyphs need, which is what pushed a third line over the collapsed height budget. -->
        <TextView
            android:id="@+id/notificationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notificationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification" />

            <!-- Hidden (gone) unless a dub/sub language badge is set — same icon+code pairing
                 used for language elsewhere in the app, instead of spelling "English Dub" out. -->
            <LinearLayout
                android:id="@+id/notificationLanguageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/notificationLanguageIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/notificationLanguageCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@android:style/TextAppearance.Material.Notification"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
