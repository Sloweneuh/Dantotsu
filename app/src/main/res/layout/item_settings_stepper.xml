<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row holding a number: icon, title and description as every row has, and − / value / +
     (the value can be typed). ControlRowLayout puts the stepper beside the text when it fits and
     under it when the text would be squeezed. See StepperConfig. -->
<ani.dantotsu.others.ControlRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:tint="?attr/colorPrimary"
        tools:ignore="ContentDescription"
        tools:srcCompat="@drawable/ic_round_art_track_24" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elegantTextHeight="true"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnBackground"
            android:textSize="16sp"
            tools:text="Line height" />

        <TextView
            android:id="@+id/settingsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.66"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Number of upcoming pages to preload while reading" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsDecrement"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/list_editor_decrease"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_round_remove_24"
            app:iconSize="18dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/text_input_layout_stroke_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/settingsValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:paddingHorizontal="4dp"
                android:textSize="13sp"
                tools:text="720" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsIncrement"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/list_editor_increase"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_round_add_24"
            app:iconSize="18dp" />
    </LinearLayout>
</ani.dantotsu.others.ControlRowLayout>
