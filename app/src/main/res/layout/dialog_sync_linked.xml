<?xml version="1.0" encoding="utf-8"?><!--
  Feedback shown right after a sync code is accepted: which account it's now scoped to, and what
  the cloud already holds. Mirrors the handoff scan result card (avatar/cover + name + a line of
  detail) so linking isn't just a toast the user has to take on faith.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/syncLinkedAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/avatar_image_description" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/syncLinkedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:textSize="19sp"
        tools:text="Username" />

    <TextView
        android:id="@+id/syncLinkedInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.75"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textSize="14sp"
        tools:text="Cloud copy saved 2 minutes ago from Pixel 8" />

</LinearLayout>
