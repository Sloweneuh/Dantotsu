<?xml version="1.0" encoding="utf-8"?>
<!-- The discovery queue's bar over a media page. Header and buttons stay visible when the
     sheet is collapsed; the "why" below them is what expanding reveals. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discoverSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/discover_sheet_background"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:id="@+id/discoverSheetHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/discoverSheetIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_manga_discover_24"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/discoverSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Discovery queue · 1 / 12" />

        <ImageView
            android:id="@+id/discoverSheetExpand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_round_arrow_drop_down_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discoverSheetExit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:minWidth="0dp"
            android:text="@string/discover_exit"
            app:icon="@drawable/ic_round_logout_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discoverSheetButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discoverSheetAdd"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/discover_add"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discoverSheetHide"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/discover_not_interested"
            android:textSize="13sp"
            app:icon="@drawable/ic_round_close_24"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discoverSheetSkip"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/discover_skip"
            android:textSize="13sp"
            app:icon="@drawable/ic_round_skip_next_24"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discoverSheetDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/discoverSheetReasonHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/discover_recommendation"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:alpha="0.7"
                android:contentDescription="@string/discover_reason_help_title"
                android:src="@drawable/ic_round_help_outline"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/discoverSheetSeeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="– You read Miss Savage Fang and 5 others" />

        <TextView
            android:id="@+id/discoverSheetHiddenGem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="– Hidden gem: rated well, read by few"
            tools:visibility="visible" />

        <!-- "Positive tags" / "Negative tags" blocks, built in code. -->
        <LinearLayout
            android:id="@+id/discoverSheetTagBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
