<?xml version="1.0" encoding="utf-8"?>
<!--
  One Comick comment. Replies use the same row, indented by the adapter, with the "replying to"
  line shown instead of hidden.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/commentAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/comick_comments"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circle"
        tools:src="@drawable/ic_round_person_24" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="Nielix" />

            <TextView
                android:id="@+id/commentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.6"
                android:textSize="12sp"
                tools:text="2 days ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/commentReplyingTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Replying to Schwarty"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/commentBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            tools:text="Comment body" />

        <TextView
            android:id="@+id/commentSpoiler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_section_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_bold"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/comick_comment_show_spoiler"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/commentImage"
            android:layout_width="wrap_content"
            android:layout_height="160dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/comick_comments"
            android:scaleType="fitStart"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:alpha="0.6"
                android:contentDescription="@string/comick_comment_score"
                android:src="@drawable/ic_round_upvote_inactive_24" />

            <TextView
                android:id="@+id/commentScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:alpha="0.6"
                android:textSize="12sp"
                tools:text="42" />

            <TextView
                android:id="@+id/commentReplyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:alpha="0.6"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="3 replies"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
