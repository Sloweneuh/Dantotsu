<?xml version="1.0" encoding="utf-8"?>
<!-- Writing an AniList review, in carded groups like the other forms: the summary, the score, the
     review itself and whether it's private, with the Markdown bar under them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <include
        android:id="@+id/reviewWriteToolbar"
        layout="@layout/layout_form_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <ani.dantotsu.others.FormSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_round_short_text_24"
                app:summary="@string/review_section_summary_desc"
                app:title="@string/review_section_summary">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Dantotsu.FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/review_summary_placeholder"
                    app:counterEnabled="true"
                    app:counterMaxLength="2200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reviewSummaryInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2200"
                        android:maxLines="4" />
                </com.google.android.material.textfield.TextInputLayout>
            </ani.dantotsu.others.FormSection>

            <ani.dantotsu.others.FormSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:icon="@drawable/ic_round_star_24"
                app:title="@string/review_section_score">

                <TextView
                    android:id="@+id/reviewScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="28sp"
                    tools:text="50 / 100" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/reviewScoreSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="50"
                    android:valueFrom="1"
                    android:valueTo="100"
                    app:labelBehavior="gone" />
            </ani.dantotsu.others.FormSection>

            <ani.dantotsu.others.FormSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:icon="@drawable/ic_round_edit_note_24"
                app:summary="@string/review_section_body_desc"
                app:title="@string/review_section_body">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reviewBodyLayout"
                    style="@style/Widget.Dantotsu.FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/review_body_placeholder"
                    app:counterEnabled="true"
                    app:counterMaxLength="50000"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reviewBodyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="50000"
                        android:minLines="10" />
                </com.google.android.material.textfield.TextInputLayout>
            </ani.dantotsu.others.FormSection>

            <ani.dantotsu.others.FormSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:icon="@drawable/ic_round_tune_24"
                app:title="@string/form_section_options">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/reviewPrivateCheckbox"
                    style="@style/Dantotsu.FormSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/private_mode" />
            </ani.dantotsu.others.FormSection>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/reviewMarkdownToolbar"
        layout="@layout/layout_markdown_toolbar" />
</LinearLayout>
