<?xml version="1.0" encoding="utf-8"?>
<!-- Fills the results area when shown (the includes are match_parent), with the state's icon
     drifting behind the message. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Follows the state icon (no results / error / extensions). -->
    <ani.dantotsu.others.PatternBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:patternAnchor="@id/emptyStateIcon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/emptyStateIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/nothing_here"
            android:src="@drawable/ic_round_search_off_24"
            app:tint="?attr/colorOnBackground" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="@string/search_no_results"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp"
            tools:text="No results found for your query." />

    </LinearLayout>
</FrameLayout>
