<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings.InfoTabsActivity">

    <LinearLayout
        android:id="@+id/infoTabsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/nav_bg_inv"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/infoTabsBack"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@color/nav_bg_inv"
                android:contentDescription="@string/back"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                app:tint="?attr/colorOnBackground" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="32dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/customize_info_tabs"
                android:textSize="28sp" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="44dp"
                android:contentDescription="@null"
                android:transitionName="settingsPageIcon"
                app:srcCompat="@drawable/ic_round_view_array_24"
                app:tint="?attr/colorOnBackground" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/infoTabsContexts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabMode="fixed" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/infoTabsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/infoTabsAdd"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/info_tabs_add_custom"
            app:icon="@drawable/ic_round_add_tinted_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/infoTabsImport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/info_tabs_import"
            app:icon="@drawable/ic_round_download_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/infoTabsDefault"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            app:icon="@drawable/ic_round_home_24"
            app:iconGravity="textStart"
            tools:text="@string/info_tabs_default" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/infoTabsReset"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/info_tabs_reset"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_round_refresh_24"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorError" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
