<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:alpha="0.4"
            android:background="@drawable/bg_top_banner_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/reader_settings"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <ani.dantotsu.others.Xpandable
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:cardInset="false"
            app:icon="@drawable/ic_round_view_array_24"
            app:isExpanded="true"
            app:title="@string/layout">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readerLayoutRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_settings_switch" />
        </ani.dantotsu.others.Xpandable>

        <ani.dantotsu.others.Xpandable
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:cardInset="false"
            app:icon="@drawable/ic_round_high_quality_24"
            app:isExpanded="false"
            app:title="@string/reader_section_display">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readerDisplayRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_settings_switch" />
        </ani.dantotsu.others.Xpandable>

        <ani.dantotsu.others.Xpandable
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:cardInset="false"
            app:icon="@drawable/ic_round_touch_app_24"
            app:isExpanded="false"
            app:title="@string/reader_section_controls">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readerControlsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_settings_switch" />
        </ani.dantotsu.others.Xpandable>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>