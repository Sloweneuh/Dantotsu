<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <ani.dantotsu.others.ChoiceToggleButton
                    android:id="@+id/statTypeAnime"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:alpha="0.33"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/anime"
                    android:textSize="12sp" />

                <ani.dantotsu.others.ChoiceToggleButton
                    android:id="@+id/statTypeManga"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:alpha="0.33"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/manga"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButtonToggleGroup
                style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                app:selectionRequired="true"
                app:singleSelection="true">

                <ani.dantotsu.others.ChoiceToggleButton
                    android:id="@+id/statMeasureCount"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:alpha="0.33"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/stats_count"
                    android:textSize="12sp" />

                <ani.dantotsu.others.ChoiceToggleButton
                    android:id="@+id/statMeasureTime"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:alpha="0.33"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/stats_hours"
                    android:textSize="12sp" />

                <ani.dantotsu.others.ChoiceToggleButton
                    android:id="@+id/statMeasureScore"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:alpha="0.33"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/score"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <CheckBox
            android:id="@+id/compare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/compare"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statisticList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_stat_section" />

        <ani.dantotsu.others.MaterialProgressBar
            android:id="@+id/statisticProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminate="true" />

        <LinearLayout
            android:id="@+id/statisticMessageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="48dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/statisticMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:fontFamily="@font/poppins_semi_bold"
                android:gravity="center"
                tools:text="@string/stats_load_failed" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statisticRetry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
