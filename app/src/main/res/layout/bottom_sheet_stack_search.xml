<?xml version="1.0" encoding="utf-8"?>
<!-- How MangaBaka's stacks are searched (StackSearchSheet): the filters of `GET /v2/stacks/search`.
     Laid out like the stack filter sheet (bottom_sheet_stack_filter): reset | saved | manage | title | sort, then
     collapsible sections, Cancel and Apply pinned at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:alpha="0.4"
                android:background="@drawable/bg_top_banner_handle" />

            <!-- Header row: reset | saved | manage | title | sort -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/stackSearchReset"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="17dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_reset_filters"
                        android:padding="8dp"
                        android:rotation="180"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_reset_star"
                        app:tint="?attr/colorPrimary" />

                    <ImageButton
                        android:id="@+id/stackSearchSavedFilters"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="15dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/saved_filters"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_round_bookmarks_outline_24"
                        app:tint="?attr/colorPrimary" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp">

                        <ImageButton
                            android:id="@+id/stackSearchManageFilters"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/manage_filters"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_round_format_list_bulleted_24"
                            android:visibility="gone"
                            app:tint="?attr/colorPrimary"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/stackSearchManageFiltersCount"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/notification_circle"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnError"
                            android:textSize="8sp"
                            android:visibility="gone"
                            tools:text="3"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/stackSearchSortButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="45dp"
                        android:layout_marginEnd="17dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sort_by"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_round_trending_up_24"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="@string/filter"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />
            </FrameLayout>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/stackSearchSectionKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_groups_24"
                app:isExpanded="true"
                app:title="@string/stack_search_kind">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/stackSearchKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/stackSearchSectionSpoilers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_visibility_off_outline_24"
                app:isExpanded="false"
                app:title="@string/stack_search_spoilers">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/stackSearchSpoilers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/stackSearchSectionSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_format_list_numbered_24"
                app:isExpanded="false"
                app:title="@string/stack_search_size">

                <TextView
                    android:id="@+id/stackSearchSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/stackSearchSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:contentDescription="@string/stack_search_size"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:labelBehavior="gone" />
            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/stackSearchSectionUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_schedule_outline_24"
                app:isExpanded="false"
                app:title="@string/stack_search_updated">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/stackSearchUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </ani.dantotsu.others.Xpandable>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Apply / Cancel buttons pinned at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/stackSearchCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="8dp"
            android:text="@string/cancel"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:strokeColor="?attr/colorOutline" />

        <Button
            android:id="@+id/stackSearchApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="8dp"
            android:text="@string/apply"
            android:textSize="15sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</FrameLayout>
