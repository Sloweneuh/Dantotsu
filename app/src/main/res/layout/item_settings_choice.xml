<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row whose control is a small set of options — one tap, one choice, all options
     visible at once — drawn as a segmented group (the Design Lab's connected toggle group).
     ControlRowLayout puts the group beside the text when it fits and under it when the text would
     be squeezed.

     The segments are built into [settingsChoices] by SettingsAdapter, so a row can offer as many (or
     as few) as it needs and hide individual ones that don't currently apply. -->
<ani.dantotsu.others.ControlRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:tint="?attr/colorPrimary"
        tools:ignore="ContentDescription"
        tools:srcCompat="@drawable/ic_round_view_list_24" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elegantTextHeight="true"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnBackground"
            android:textSize="16sp"
            tools:text="Layout" />

        <TextView
            android:id="@+id/settingsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.66"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Paged" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/settingsChoices"
        style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true" />
</ani.dantotsu.others.ControlRowLayout>
