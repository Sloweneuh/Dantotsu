<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row whose control is a small set of icon buttons — one tap, one choice, all options
     visible at once. Same shape as item_settings_slider: title, description, then the control.

     The buttons are built into [settingsChoices] by SettingsAdapter, so a row can offer as many (or
     as few) as it needs and hide individual ones that don't currently apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:layout_marginEnd="24dp"
        app:srcCompat="@drawable/ic_circle_add"
        app:tint="?attr/colorPrimary"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44sp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elegantTextHeight="true"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/name"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorOnBackground"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/settingsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.66"
            android:fontFamily="@font/poppins_semi_bold"
            android:paddingRight="28dp"
            android:text="@string/slogan"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/settingsChoices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
