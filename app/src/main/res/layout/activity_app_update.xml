<?xml version="1.0" encoding="utf-8"?><!--
    Header and action bar are pinned to the top and bottom; the patch notes get whatever is left
    over and are the only thing that scrolls, so the download/install control is never pushed off
    screen by a long changelog.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appUpdateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".others.AppUpdateActivity">

    <ImageButton
        android:id="@+id/appUpdateBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
        app:tint="?attr/colorOnBackground" />

    <!-- Centred hero: the logo, the title, the version change as two pills (where you are, muted;
         where this goes, in the accent), then when it was released and a link to the release. -->
    <LinearLayout
        android:id="@+id/appUpdateHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appUpdateBack">

        <ImageView
            android:id="@+id/appUpdateLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:srcCompat="@drawable/anim_splash"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_update"
            android:textColor="?attr/colorOnBackground"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appUpdateCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/app_update_version_pill"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="5.7.1-beta01" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                app:srcCompat="@drawable/ic_round_arrow_forward_ios_new_24"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/appUpdateVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/app_update_version_pill"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="13sp"
                tools:text="5.8.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appUpdateReleased"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Released 26 Oct 2026  ·  "
                tools:visibility="visible" />

            <TextView
                android:id="@+id/appUpdateGithub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/update_view_on_github"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The only scrolling region. 0dp height between the header and the action bar. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/appUpdateNotesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@id/appUpdateDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appUpdateHeader">

        <!-- Section cards are added here by code; the TextView holds any text outside them (or the
             whole changelog, when it isn't in the usual sections shape). -->
        <LinearLayout
            android:id="@+id/appUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/appUpdatePatchNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp"
                tools:text="- Fixed a bunch of things\n- Broke a bunch of others" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/appUpdateDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toTopOf="@id/appUpdateActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/appUpdateActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/appUpdateSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:maxLines="1"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="19.1 MB / 45.6 MB · 42%"
            tools:visibility="visible" />

        <!-- One control for both jobs: the button fills with progress while downloading, so it is
             never swapped out. Centred at 70% width, with cancel alongside it only mid-download. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ani.dantotsu.others.UpdateActionButton
                android:id="@+id/appUpdateAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.7" />

            <ImageButton
                android:id="@+id/appUpdateCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/appUpdateAction"
                app:layout_constraintStart_toEndOf="@id/appUpdateAction"
                app:layout_constraintTop_toTopOf="@id/appUpdateAction"
                app:srcCompat="@drawable/ic_round_close_24"
                app:tint="?attr/colorOnBackground"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
