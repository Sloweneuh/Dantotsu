<?xml version="1.0" encoding="utf-8"?><!--
    Header and action bar are pinned to the top and bottom; the patch notes get whatever is left
    over and are the only thing that scrolls, so the download/install control is never pushed off
    screen by a long changelog.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appUpdateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".others.AppUpdateActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/appUpdateBackCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/appUpdateBack"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/nav_bg_inv"
            android:paddingVertical="16dp"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/appUpdateHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appUpdateBackCard">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="32dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/app_update"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/appUpdateVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:fontFamily="@font/poppins_semi_bold"
                android:textSize="14sp"
                tools:text="4.7.4 → 4.8.0" />
        </LinearLayout>

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:padding="24dp"
            app:srcCompat="@drawable/ic_round_new_releases_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- The only scrolling region. 0dp height between the header and the action bar. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/appUpdateNotesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@id/appUpdateDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appUpdateHeader">

        <TextView
            android:id="@+id/appUpdatePatchNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            tools:text="- Fixed a bunch of things\n- Broke a bunch of others" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/appUpdateDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toTopOf="@id/appUpdateActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/appUpdateActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/appUpdateSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:maxLines="1"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="19.1 MB / 45.6 MB · 42%"
            tools:visibility="visible" />

        <!-- One control for both jobs: the button fills with progress while downloading, so it is
             never swapped out. Centred at 70% width, with cancel alongside it only mid-download. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ani.dantotsu.others.UpdateActionButton
                android:id="@+id/appUpdateAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.7" />

            <ImageButton
                android:id="@+id/appUpdateCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/appUpdateAction"
                app:layout_constraintStart_toEndOf="@id/appUpdateAction"
                app:layout_constraintTop_toTopOf="@id/appUpdateAction"
                app:srcCompat="@drawable/ic_round_close_24"
                app:tint="?attr/colorOnBackground"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
