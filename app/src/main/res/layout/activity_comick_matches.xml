<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comickMatchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings.ComickMatchesActivity">

    <!-- Shown with the "nothing here" message only. -->
    <ani.dantotsu.others.PatternBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:patternAnchor="@id/comickMatchEmpty"
        app:patternIcon="@drawable/ic_round_comick_24" />

    <LinearLayout
        android:id="@+id/comickMatchLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/nav_bg_inv"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/comickMatchBack"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@color/nav_bg_inv"
                android:contentDescription="@string/back"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                app:tint="?attr/colorOnBackground" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/comick_matches_title"
                android:textSize="28sp" />

            <!-- No padding: the flight to and from the row scales the whole view, padding and all,
                 so a padded icon shrank to a fraction of the row's on the way back. -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="12dp"
                android:transitionName="settingsPageIcon"
                app:srcCompat="@drawable/ic_round_comick_24"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <TextView
            android:id="@+id/comickMatchSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.7"
            android:paddingHorizontal="16dp"
            tools:text="12 titles in your lists couldn't be matched to Comick." />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comickMatchRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_comick_match" />

            <TextView
                android:id="@+id/comickMatchEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="@string/comick_matches_empty"
                android:visibility="gone" />

            <ani.dantotsu.others.MaterialProgressBar
                android:id="@+id/comickMatchProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
