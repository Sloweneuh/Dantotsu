<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:alpha="0.4"
                android:background="@drawable/bg_top_banner_handle" />

            <!-- Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
    
                    <ImageButton
                        android:id="@+id/kitsuFilterReset"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="17dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/reset"
                        android:rotation="180"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_round_reset_star_24"
                        app:tint="?attr/colorPrimary" />
    
                    <ImageButton
                        android:id="@+id/kitsuSavedFiltersButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="15dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/saved_filters"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_round_bookmarks_24"
                        app:tint="?attr/colorPrimary" />
    
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
    
                    <ImageButton
                        android:id="@+id/kitsuFilterSortButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="45dp"
                        android:layout_marginEnd="17dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sort_by"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_round_sort_24"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/filter"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp" />
            </FrameLayout>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/kitsuSectionFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_filter_alt_24"
                app:isExpanded="true"
                app:title="@string/filter_section_format">

                <!-- Subtype / Format -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/kitsu_filter_subtype"
                    android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                <ani.dantotsu.FadingEdgeRecyclerView
                    android:requiresFadingEdge="horizontal"
                    android:id="@+id/kitsuFilterSubtypeRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_chip" />

                <!-- Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/status_title"
                    android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                <ani.dantotsu.FadingEdgeRecyclerView
                    android:requiresFadingEdge="horizontal"
                    android:id="@+id/kitsuFilterStatusRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_chip" />

                <!-- Age rating (anime only) -->
                <TextView
                    android:id="@+id/kitsuFilterAgeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/kitsu_filter_age_rating"
                    android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                <ani.dantotsu.FadingEdgeRecyclerView
                    android:requiresFadingEdge="horizontal"
                    android:id="@+id/kitsuFilterAgeRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_chip" />

                <!-- Season (anime only) -->
                <TextView
                    android:id="@+id/kitsuFilterSeasonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/kitsu_filter_season"
                    android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                <ani.dantotsu.FadingEdgeRecyclerView
                    android:requiresFadingEdge="horizontal"
                    android:id="@+id/kitsuFilterSeasonRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_chip" />
            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/kitsuSectionCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_menu_book_24"
                app:isExpanded="false"
                app:title="@string/kitsu_filter_categories">

                <!-- Categories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/kitsuCategoriesSearchBtn"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/search"
                            app:srcCompat="@drawable/ic_round_search_24"
                            app:tint="?attr/colorOnBackground" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/kitsuCategorySearchLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:maxWidth="140dp"
                            android:minHeight="0dp"
                            android:visibility="gone"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/text_input_layout_stroke_color"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/kitsuCategorySearchText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center_vertical"
                                android:hint="@string/search"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:minHeight="0dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="@string/grid"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/kitsuCategoriesGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <ani.dantotsu.FadingEdgeRecyclerView
                    android:requiresFadingEdge="horizontal"
                    android:id="@+id/kitsuFilterCategoriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                android:id="@+id/kitsuSectionYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                app:accordion="true"
                app:cardInset="false"
                app:icon="@drawable/ic_round_date_range_24"
                app:isExpanded="false"
                app:title="@string/year_range">

                <!-- Year range -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">


                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/kitsuFilterYearRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="1900"
                        android:valueTo="2030" />
                </LinearLayout>
            </ani.dantotsu.others.Xpandable>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/kitsuFilterCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="8dp"
            android:text="@string/cancel"
                    android:textSize="15sp"
            app:cornerRadius="16dp"
            app:strokeColor="?attr/colorOutline" />

        <Button
            android:id="@+id/kitsuFilterApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="8dp"
            android:text="@string/apply"
                    android:textSize="15sp"
            app:cornerRadius="16dp" />
    </LinearLayout>

</FrameLayout>
