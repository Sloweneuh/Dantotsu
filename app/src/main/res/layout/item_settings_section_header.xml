<?xml version="1.0" encoding="utf-8"?>
<!-- The header Xpandable builds for itself, so a collapsible group on the Player and Reader screens
     is the same object as a card from SettingsSectionAdapter: icon, title, one-line summary, and a
     chevron that turns. Deliberately the same metrics as item_settings_section.xml's header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sectionHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/sectionIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:tint="?attr/colorPrimary"
        tools:ignore="ContentDescription"
        tools:srcCompat="@drawable/ic_round_video_settings_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="Video" />

        <TextView
            android:id="@+id/sectionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="Speed and resize mode" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sectionChevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/ic_round_arrow_drop_down_24"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:ignore="ContentDescription" />
</LinearLayout>
