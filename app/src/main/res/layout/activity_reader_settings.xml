<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings.ReaderSettingsActivity"
    tools:ignore="SpeakableTextPresentCheck">

    <LinearLayout
        android:id="@+id/readerSettingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/nav_bg_inv"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageButton
                    android:contentDescription="@string/back"
                    android:id="@+id/readerSettingsBack"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@color/nav_bg_inv"
                    android:padding="16dp"
                    app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="32dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/manga_and_reader"
                    android:textSize="28sp" />

                <ImageView
                    android:id="@+id/settingsLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="44dp"
                    android:layout_marginBottom="24dp"
                    android:transitionName="settingsPageIcon"
                    app:srcCompat="@drawable/ic_round_import_contacts_24"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </LinearLayout>

        <!-- The library rows that were the whole of the Manga screen. First because they apply
             before a chapter is opened. -->
        <ani.dantotsu.others.Xpandable
            app:accordion="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:stateKey="reader_library"
            app:stateScope="reader"
            app:title="@string/library"
            app:summary="@string/library_manga_group_desc"
            app:icon="@drawable/ic_round_library_books_24">

            <ani.dantotsu.FadingEdgeRecyclerView
                android:id="@+id/settingsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:nestedScrollingEnabled="false"
                android:requiresFadingEdge="vertical"
                tools:itemCount="2"
                tools:listitem="@layout/item_settings" />
        </ani.dantotsu.others.Xpandable>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:clipToPadding="false"
            android:orientation="vertical">

            <ani.dantotsu.others.Xpandable
                app:accordion="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:stateKey="reader_manga"
                app:stateScope="reader"
                app:title="@string/default_manga_settings"
                app:summary="@string/manga_reader_group_desc"
                app:icon="@drawable/ic_round_import_contacts_24">

                <!-- Sub-sections, as in the reader's own settings sheet. -->
                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_view_array_24"
                    app:title="@string/layout">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerMangaLayoutRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_high_quality_24"
                    app:title="@string/reader_section_display">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerMangaDisplayRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_touch_app_24"
                    app:title="@string/reader_section_controls">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerMangaControlsRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

            </ani.dantotsu.others.Xpandable>

            <!-- OCR & MTL; delete with ani.dantotsu.spike -->
            <ani.dantotsu.others.Xpandable
                app:accordion="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:icon="@drawable/ic_round_translate_24"
                app:stateKey="reader_ocr_mtl"
                app:stateScope="reader"
                app:summary="@string/ocr_mtl_desc"
                app:title="@string/ocr_mtl">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/readerMtlRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_settings_switch" />

            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                app:accordion="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:stateKey="reader_novel"
                app:stateScope="reader"
                app:title="@string/default_novel_settings"
                app:summary="@string/novel_reader_group_desc"
                app:icon="@drawable/ic_round_menu_book_24">

                <!-- Sub-sections, as in the reader's own settings sheet. -->
                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_view_array_24"
                    app:title="@string/layout">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerNovelLayoutRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_format_text_24"
                    app:title="@string/reader_section_text">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerNovelTextRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_high_quality_24"
                    app:title="@string/reader_section_display">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerNovelDisplayRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

                <ani.dantotsu.others.Xpandable
                    app:accordion="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:icon="@drawable/ic_round_touch_app_24"
                    app:title="@string/reader_section_controls">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/readerNovelControlsRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_settings_switch" />
                </ani.dantotsu.others.Xpandable>

            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                app:accordion="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:stateKey="reader_general"
                app:stateScope="reader"
                app:title="@string/general"
                app:summary="@string/general_group_desc"
                app:icon="@drawable/ic_round_tune_24">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readerGeneralRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_settings_switch" />

            </ani.dantotsu.others.Xpandable>

            <ani.dantotsu.others.Xpandable
                app:accordion="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:stateKey="reader_progress"
                app:stateScope="reader"
                app:title="@string/update_progress"
                app:summary="@string/update_progress_reader_group_desc"
                app:icon="@drawable/ic_round_sync_24">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readerProgressRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_settings_switch" />

            </ani.dantotsu.others.Xpandable>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>