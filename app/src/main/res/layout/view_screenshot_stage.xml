<?xml version="1.0" encoding="utf-8"?><!--
    The screenshot "stage": the share card being composed, plus the control that starts a crop.
    Shared verbatim by the portrait and landscape sheets, which only differ in where they put it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp">

    <!-- Crop-mode hint. Outside the card, so it never lands in the saved image. -->
    <TextView
        android:id="@+id/screenshotCropHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins"
        android:gravity="center_horizontal"
        android:text="@string/screenshot_crop_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- The share card. This whole container is what gets rendered to the saved image. -->
    <LinearLayout
        android:id="@+id/screenshotCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_screenshot_card"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- The crop overlay sits exactly on top of the preview; the ImageView uses
             adjustViewBounds so its drawable fills its bounds edge to edge. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/screenshotImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/screenshot_preview"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/backgrounds/scenic[0]" />

            <ani.dantotsu.media.screenshot.CropOverlayView
                android:id="@+id/screenshotCropOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/screenshotDecorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/screenshotCaptionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/screenshotCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingMultiplier="1.05"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    tools:text="What a moment!" />

                <ImageView
                    android:id="@+id/screenshotLogoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_dantotsu_logo"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- ConstraintLayout so the logo (bottom-aligned, next to the lower text rows)
                 doesn't steal width from the title, which visually sits above it. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/screenshotMediaInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/screenshotCover"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/cover"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@tools:sample/backgrounds/scenic[1]" />

                <TextView
                    android:id="@+id/screenshotTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/screenshotCover"
                    app:layout_constraintTop_toTopOf="@id/screenshotCover"
                    tools:text="One Piece" />

                <LinearLayout
                    android:id="@+id/screenshotTitleBelow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/screenshotLogoInline"
                    app:layout_constraintStart_toEndOf="@id/screenshotCover"
                    app:layout_constraintTop_toBottomOf="@id/screenshotTitle">

                    <TextView
                        android:id="@+id/screenshotSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        tools:text="1050 • 8/24" />

                    <TextView
                        android:id="@+id/screenshotDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        tools:text="Jul 11, 2026 · 14:30" />

                    <TextView
                        android:id="@+id/screenshotSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        tools:text="MangaDex" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/screenshotLogoInline"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_dantotsu_logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- User + app footer -->
            <LinearLayout
                android:id="@+id/screenshotFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/screenshotUserInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/screenshotAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/avatar"
                        android:scaleType="centerCrop"
                        tools:src="@tools:sample/avatars" />

                    <TextView
                        android:id="@+id/screenshotUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="Username" />

                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/screenshotLogoFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_dantotsu_logo" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Enters crop mode: the overlay above becomes interactive and the bottom bar swaps to the
         crop actions. -->
    <Button
        android:id="@+id/screenshotCropStart"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/screenshot_crop"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_crop_24"
        app:strokeColor="?attr/colorPrimaryContainer" />

</LinearLayout>
