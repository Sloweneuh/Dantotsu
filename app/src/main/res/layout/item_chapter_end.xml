<?xml version="1.0" encoding="utf-8"?>
<!-- The page after a chapter's last one, when chapters are read one at a time (ImageAdapter): what
     was finished, what comes next and who scanlated it, any chapters missing in between, and the way
     on. Fixed light-on-dark colours, like the reader's other overlays: it sits among the pages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#CC000000"
    android:gravity="center"
    android:minHeight="320dp"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_round_check_circle_outline_24"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/chapterEndCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.7"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        tools:text="End of 12 : The Desert" />

    <View
        android:layout_width="64dp"
        android:layout_height="2dp"
        android:layout_marginVertical="16dp"
        android:alpha="0.4"
        android:background="@android:color/white" />

    <TextView
        android:id="@+id/chapterEndNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        tools:text="Next: 13 : The Island" />

    <TextView
        android:id="@+id/chapterEndGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Some Scans"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/chapterEndGap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawablePadding="8dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:textColor="#FFFFAA00"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_round_warning_24"
        app:drawableTint="#FFFFAA00"
        tools:text="2 chapters are missing between these"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chapterEndNextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/chapter_end_next"
        app:icon="@drawable/ic_round_skip_next_24" />
</LinearLayout>
