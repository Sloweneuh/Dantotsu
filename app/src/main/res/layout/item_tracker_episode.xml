<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_outline"
    android:backgroundTint="?attr/colorSurfaceVariant"
    android:backgroundTintMode="src_atop"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="79dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/trackerEpisodeThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:src="@tools:sample/backgrounds/scenic" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackerEpisodeNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:fontFamily="@font/poppins_bold"
                android:textSize="11sp"
                tools:text="EP 1" />

            <TextView
                android:id="@+id/trackerEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="2"
                android:textSize="14sp"
                app:lineHeight="16sp"
                tools:text="The Journey's End" />

            <TextView
                android:id="@+id/trackerEpisodeDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                tools:text="29 Sep 2023" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/trackerEpisodeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.58"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        app:lineHeight="16sp"
        tools:text="@tools:sample/lorem/random" />

</LinearLayout>
