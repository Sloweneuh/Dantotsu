<?xml version="1.0" encoding="utf-8"?><!-- One media row in a list widget; bound by MediaListFactory. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <!--
        An activity row's cover is the media's, not the acting user's — this is what actually says whose
        activity it is, so it leads the row rather than sitting as a badge cropped into the cover's
        corner, where it was too small to recognise anyone by.

        match_parent height + adjustViewBounds is what makes it track the row: the bitmap is square (see
        BitmapUtil.toCircularBitmap), so the width follows whatever height the row settles at, which grows
        when a title wraps to a second line. maxWidth/maxHeight hold it just under the cover's height —
        the avatar and the cover both eat into the title's width, and letting it match a two-line row
        outright cost enough of that to truncate titles that used to fit.

        Only used by the activity widget — see WidgetItem.avatarUrl / MediaListFactory.

        marginEnd rather than the cover carrying a marginStart: a GONE view contributes no margins, so
        every other widget (which has no avatar) gets its cover flush to the row's leading edge.
    -->
    <ImageView
        android:id="@+id/itemAvatar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:adjustViewBounds="true"
        android:maxWidth="48dp"
        android:maxHeight="48dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/itemCover"
        android:layout_width="38dp"
        android:layout_height="52dp"
        android:contentDescription="@string/airing_image"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="2"
            android:textSize="14sp"
            tools:text="@string/widget_preview_title" />

        <!--
            The second line. itemSubtitle carries the counts text and, for a manga row, its source as
            plain text ending the string. An anime row instead ends the string with a bare " ·" (see
            MediaListFactory.subtitle()) and shows its language as the icon + code pair after it — the
            dub/sub distinction doesn't reduce to a word the way a site or scanlation group name does.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
                wrap_content and not weighted: the icon+code have to sit right after the text, not
                pinned to the row's far end — a weighted 0dp box left the icon stranded behind a gap of
                blank space whenever the text was shorter than the box. The counts+"next" text this
                actually holds is short and bounded, so the rare very long title/count overflowing
                un-ellipsized is an acceptable trade for that.
            -->
            <TextView
                android:id="@+id/itemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/poppins"
                android:textSize="12sp"
                tools:text="@string/widget_preview_subtitle" />

            <ImageView
                android:id="@+id/itemLanguageIcon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_anime_sub_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/itemLanguageCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/poppins"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="EN" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
