<?xml version="1.0" encoding="utf-8"?>
<!-- The count hung over the bottom edge of a stack of app notices (TopBanner): "+2" while the ones
     behind only peek out, "Less" once they are unfolded. Lifted a step above the cards, which it
     sits half over. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/topBannerChipIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_round_arrow_drop_down_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/topBannerChipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="+2" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
