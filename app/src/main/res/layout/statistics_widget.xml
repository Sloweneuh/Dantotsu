<?xml version="1.0" encoding="utf-8"?><!--
    The profile stats widget; see ProfileStatsWidget.

    Two states share this layout: the 2x2 grid of counts, and a single centred line for "signed out",
    "offline" and "loading". Those messages used to be spelled across the four stat slots, one word per
    corner ("please" / "log in" / "or join" / "anilist"), which no other state could reuse.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Dantotsu.AppWidgetContainer">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/userAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/user_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_dantotsu_round" />

            <TextView
                android:id="@+id/userLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:textSize="14sp"
                tools:text="@string/statistics" />

            <ProgressBar
                android:id="@+id/widgetProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:padding="6dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widgetRefresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/refresh"
                android:padding="6dp"
                android:src="@drawable/ic_round_refresh_24" />

            <ImageView
                android:id="@+id/widgetConfigure"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/widget_configure_title"
                android:padding="6dp"
                android:src="@drawable/ic_round_settings_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetMessage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:maxLines="3"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="@string/widget_sign_in" />

        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/topLeftItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/topLeftLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/anime_watched" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/topRightItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value_two" />

                    <TextView
                        android:id="@+id/topRightLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/episodes_watched_n" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/bottomLeftItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/bottomLeftLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/manga_read" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/bottomRightItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value_two" />

                    <TextView
                        android:id="@+id/bottomRightLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/chapters_read_n" />
                </LinearLayout>
            </LinearLayout>

            <!--
                Only shown once the widget is tall enough to hold it — see ProfileStatsWidget.rowsFor().
                GONE rather than INVISIBLE here: these are whole rows, so the ones above simply take the
                space back, unlike an individual empty cell which has to hold its place in the grid.
            -->
            <LinearLayout
                android:id="@+id/statsRowThree"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/rowThreeLeftItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/rowThreeLeftLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/days_watched" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/rowThreeRightItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value_two" />

                    <TextView
                        android:id="@+id/rowThreeRightLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/volumes_read_n" />
                </LinearLayout>
            </LinearLayout>

            <!--
                Only shown once the widget is tall enough to hold it — see ProfileStatsWidget.rowsFor().
                GONE rather than INVISIBLE here: these are whole rows, so the ones above simply take the
                space back, unlike an individual empty cell which has to hold its place in the grid.
            -->
            <LinearLayout
                android:id="@+id/statsRowFour"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/rowFourLeftItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value" />

                    <TextView
                        android:id="@+id/rowFourLeftLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/days_watched" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidgetStatCell"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/rowFourRightItem"
                        style="@style/WidgetStatValue"
                        tools:text="@string/widget_preview_stat_value_two" />

                    <TextView
                        android:id="@+id/rowFourRightLabel"
                        style="@style/WidgetStatLabel"
                        tools:text="@string/volumes_read_n" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
